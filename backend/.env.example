# ===== MySQL（可选：留空则「存档 / 档案」不可用） =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_DATABASE=your-database

# ===== AI（可选：留空走内置风格词典） =====
# OpenAI 兼容接口地址，注意不要在同一行写注释
BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
API_KEY=your-api-key

# ===== 高级：仅在需要覆盖默认配置时填写 =====
# 服务地址默认 127.0.0.1:8300（见 config.yaml）
# UIDIY_HOST=127.0.0.1
# UIDIY_PORT=8300
# CORS 仅当前后端不同源直连（不用 Vite proxy）时才需要；本项目用代理，一般不用填
# UIDIY_CORS=http://localhost:5180,http://127.0.0.1:5180
